{
  "name": "AIVideo – Onay bildirimi (Control API)",
  "nodes": [
    { "name": "Cron 09:00", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [0, 0], "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }] } } },
    { "name": "Özet al", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [240, 0],
      "retryOnFail": false,
      "parameters": { "url": "http://127.0.0.1:8787/health", "method": "GET" } },
    { "name": "Telegram", "type": "n8n-nodes-base.telegram", "typeVersion": 1, "position": [480, 0], "retryOnFail": false,
      "parameters": { "chatId": "={{$env.TELEGRAM_ALLOWED_CHAT_ID}}", "text": "AI Video Studio günlük özet hazır" } }
  ],
  "connections": { "Cron 09:00": { "main": [[{ "node": "Özet al", "type": "main", "index": 0 }]] }, "Özet al": { "main": [[{ "node": "Telegram", "type": "main", "index": 0 }]] } },
  "settings": { "executionOrder": "v1" }
}
